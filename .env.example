APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://bayline:replace-with-url-encoded-password@localhost:5432/bayline
BUSINESS_CURRENCY=USD
BUSINESS_TIMEZONE=UTC
PORT=3000
# Production uses HTTPS. Set proxy trust only behind exactly one trusted proxy.
TRUST_SINGLE_PROXY=false
# Generate: openssl rand -hex 32. Keep this key with encrypted backups.
TOKEN_ENCRYPTION_KEY=
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_FIRST_CONTACT_FIELD=
GHL_NEXT_FOLLOWUP_FIELD=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_SANDBOX=true
QBO_BASIS=Accrual
HYROS_API_KEY=
HYROS_TIMEZONE_CONFIRMED=
HYROS_CAMPAIGNS=[]
# Per-source random secrets, at least 32 characters. Blank disables a bridge.
BRIDGE_TINTWIZ_SECRET=
BRIDGE_GHL_SECRET=
BRIDGE_QBO_SECRET=
BRIDGE_HYROS_SECRET=
# For Docker Compose only:
DOMAIN=
POSTGRES_PASSWORD=
BAYLINE_DB_PASSWORD=
